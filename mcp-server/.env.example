# TripCanvas MCP Server Environment Variables
# Copy this file to .env in the mcp-server/ directory.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server!

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Port for the Streamable HTTP MCP server (default: 3001)
PORT=3001

# Allowed CORS origins (comma-separated, or * for public MCP clients like Claude)
CORS_ORIGIN="*"

# Optional: Expected public base URL of this MCP server for health/info metadata
MCP_PUBLIC_URL="http://localhost:3001"
