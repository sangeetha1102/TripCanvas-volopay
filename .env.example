# Frontend & Web Server Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in any VITE_* variable or frontend code.

# Public Supabase Project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public Supabase Anon / Publishable Key (Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: Public URL of your deployed MCP Server (displayed in the MCP Access page)
VITE_MCP_SERVER_URL="http://localhost:3001/mcp"

# Server Port (defaults to 3000)
PORT=3000

# Public URL where the web app is hosted
APP_URL="http://localhost:3000"
